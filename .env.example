# ===================================================================
# AI 服务配置（支持 DeepSeek 和 GLM）
# ===================================================================

# 选择 AI 提供商: deepseek 或 glm
VITE_AI_PROVIDER=deepseek

# API Key（必填）
# DeepSeek: https://platform.deepseek.com/api_keys
# GLM (智谱AI): https://open.bigmodel.cn/usercenter/apikeys
VITE_AI_API_KEY=your_api_key_here

# API Base URL（可选，留空使用默认值）
# DeepSeek 默认: https://api.deepseek.com
# GLM 默认: https://open.bigmodel.cn/api/paas/v4/
VITE_AI_BASE_URL=

# 模型名称（可选，留空使用默认模型）
# DeepSeek 推荐模型:
#   - deepseek-chat (通用对话)
#   - deepseek-reasoner (深度推理，适合复杂分析)
# GLM 推荐模型:
#   - glm-4-flash (快速响应)
#   - glm-4-plus (更强能力)
#   - glm-4-0520 (稳定版本)
VITE_AI_MODEL=

# ===================================================================
# 配置示例
# ===================================================================

# 示例 1: 使用 DeepSeek（推荐）
# VITE_AI_PROVIDER=deepseek
# VITE_AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# VITE_AI_MODEL=deepseek-reasoner

# 示例 2: 使用 GLM
# VITE_AI_PROVIDER=glm
# VITE_AI_API_KEY=xxxxxxxxxxxxxxxx.xxxxxxxx
# VITE_AI_MODEL=glm-4-plus
